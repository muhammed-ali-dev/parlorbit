ADDR=:8080
DATABASE_PATH=roomcade.db
STATIC_DIR=dist
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SECURE_COOKIES=false
METRICS_TOKEN=replace-with-a-long-random-secret

# Optional audio/video calls. See MEDIA.md for a local LiveKit development server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional battleground prompt resolver. Backend only; do not expose keys.
GEMINI_API_KEY=
BATTLE_AI_MODEL=gemini-3.5-flash-lite


# Owner-controlled AI allowance shared across all Houses/rooms; persisted in SQLite.
# Fixed UTC windows. Failed calls count. Zero/invalid limits disable calls.
BATTLE_AI_ENABLED=true
BATTLE_AI_MAX_MINUTE_CALLS=2
BATTLE_AI_MAX_HOURLY_CALLS=10
BATTLE_AI_MAX_DAILY_CALLS=30
BATTLE_AI_MAX_MONTHLY_CALLS=300


# Shared demo entry password (12+ characters). Never commit the actual password.
# Render requires this gate; local development can leave it unconfigured.
DEMO_PASSWORD=
DEMO_PASSWORD_REQUIRED=false
